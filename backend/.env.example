NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cuidagro:cuidagro_dev@127.0.0.1:5433/cuidagro

# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplazar-con-un-secreto-de-al-menos-32-caracteres

# Duración de la sesión. El refresh es largo porque se trabaja días sin señal.
ACCESS_TTL_SEGUNDOS=900
REFRESH_TTL_DIAS=30

# Solo si el frontend vive en otro origen (separar varios con coma).
CORS_ORIGIN=
# Número de proxies inversos delante de la API (0 en local).
TRUST_PROXY=0
LOGIN_MAX_INTENTOS=10

# Directorio de las fotos de novedades (relativo a backend/ o absoluto). Se crea solo.
UPLOADS_DIR=uploads

# Primer administrador, creado por `npm run db:seed`.
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_CORREO=admin@cuidagro.local
SEED_ADMIN_PASSWORD=
