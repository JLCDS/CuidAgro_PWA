generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

model Rol {
  id          String    @id @default(uuid()) @db.Uuid
  nombre      String    @unique
  descripcion String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  usuarios    Usuario[]

  @@map("roles")
}

model Finca {
  id           String          @id @default(uuid()) @db.Uuid
  nombre       String
  ubicacion    String?
  descripcion  String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  usuarios     UsuarioFinca[]
  vacunos      Vacuno[]
  lotes        LoteOviparo[]
  espacios     Espacio[]
  raciones     RacionSemanal[]
  alimentos    Alimento[]
  novedades    Novedad[]
  casosSalud   CasoSalud[]
  medicamentos Medicamento[]
  tratamientos Tratamiento[]

  @@index([nombre])
  @@map("fincas")
}

model Usuario {
  id                  String               @id @default(uuid()) @db.Uuid
  nombre              String
  correo              String               @unique
  passwordHash        String               @map("password_hash")
  estado              EstadoUsuario        @default(ACTIVO)
  rolId               String               @map("rol_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  rol                 Rol                  @relation(fields: [rolId], references: [id], onDelete: Restrict)
  fincas              UsuarioFinca[]
  refreshTokens       RefreshToken[]
  vacunosCreados      Vacuno[]
  lotesCreados        LoteOviparo[]
  espaciosCreados     Espacio[]
  alimentosCreados    Alimento[]
  entradasAlimento    EntradaAlimento[]
  consumosVacunos     ConsumoVacuno[]
  consumosLotes       ConsumoLote[]
  novedades           Novedad[]
  comentarios         ComentarioNovedad[]
  casosSalud          CasoSalud[]
  medicamentosCreados Medicamento[]
  entradasMedicamento EntradaMedicamento[]
  tratamientos        Tratamiento[]
  suscripcionesPush   SuscripcionPush[]

  @@index([rolId])
  @@index([estado])
  @@map("usuarios")
}

model UsuarioFinca {
  usuarioId String   @map("usuario_id") @db.Uuid
  fincaId   String   @map("finca_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  finca     Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, fincaId])
  @@index([fincaId])
  @@map("usuarios_fincas")
}

/// Sesiones. `familiaId` agrupa las rotaciones de un mismo inicio de sesión.
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  familiaId     String    @map("familia_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  reemplazadoAt DateTime? @map("reemplazado_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familiaId])
  @@map("refresh_tokens")
}

enum Sexo {
  MACHO
  HEMBRA
}

enum PropositoVacuno {
  ALIMENTACION
  PRODUCCION_LECHERA
  ENGORDE
}

enum PropositoLote {
  PRODUCCION
  ALIMENTACION
}

/// Baja lógica: los registros nunca se borran porque la alimentación los referencia.
enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

/// Único por finca sin distinguir mayúsculas: índice `(finca_id, lower(nombre))` añadido a mano en la migración.
model Vacuno {
  id            String          @id @default(uuid()) @db.Uuid
  fincaId       String          @map("finca_id") @db.Uuid
  nombre        String
  sexo          Sexo
  raza          String
  edadMeses     Int             @map("edad_meses")
  peso          Decimal         @db.Decimal(7, 2)
  fechaLlegada  DateTime        @map("fecha_llegada") @db.Date
  proposito     PropositoVacuno
  estado        EstadoRegistro  @default(ACTIVO)
  motivoBaja    String?         @map("motivo_baja")
  observaciones String?
  creadoPorId   String          @map("creado_por_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  finca         Finca           @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  creadoPor     Usuario         @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)

  consumos     ConsumoVacuno[]
  novedades    Novedad[]
  casosSalud   CasoSalud[]
  tratamientos Tratamiento[]

  @@index([fincaId])
  @@index([estado])
  @@map("vacunos")
}

/// Único por finca sin distinguir mayúsculas: índice `(finca_id, lower(nombre))` añadido a mano en la migración.
/// Un espacio solo admite un lote activo: índice único parcial `lotes_espacio_activo_uq` añadido a mano.
model LoteOviparo {
  id             String         @id @default(uuid()) @db.Uuid
  fincaId        String         @map("finca_id") @db.Uuid
  nombre         String
  tipoAve        String?        @map("tipo_ave")
  edadMinSemanas Int            @map("edad_min_semanas")
  edadMaxSemanas Int            @map("edad_max_semanas")
  cantidad       Int
  proposito      PropositoLote
  fechaIngreso   DateTime?      @map("fecha_ingreso") @db.Date
  espacioId      String?        @map("espacio_id") @db.Uuid
  estado         EstadoRegistro @default(ACTIVO)
  motivoBaja     String?        @map("motivo_baja")
  observaciones  String?
  creadoPorId    String         @map("creado_por_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  finca          Finca          @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  creadoPor      Usuario        @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  espacio        Espacio?       @relation(fields: [espacioId], references: [id], onDelete: Restrict)

  consumos     ConsumoLote[]
  novedades    Novedad[]
  casosSalud   CasoSalud[]
  tratamientos Tratamiento[]

  @@index([fincaId])
  @@index([estado])
  @@index([espacioId])
  @@map("lotes_oviparos")
}

enum TipoEspacio {
  CUADRANTE
  ZONA
  OTRO
}

/// Cuadrante o zona del galpón. Código único por finca (en mayúsculas).
model Espacio {
  id            String         @id @default(uuid()) @db.Uuid
  fincaId       String         @map("finca_id") @db.Uuid
  codigo        String
  nombre        String?
  tipo          TipoEspacio
  capacidad     Int?
  estado        EstadoRegistro @default(ACTIVO)
  motivoBaja    String?        @map("motivo_baja")
  observaciones String?
  creadoPorId   String         @map("creado_por_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  finca         Finca          @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  creadoPor     Usuario        @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)

  lotes    LoteOviparo[]
  consumos ConsumoLote[]

  @@unique([fincaId, codigo])
  @@map("espacios")
}

/// Ración por semana de vida (g por ave y día). Sin filas, se usa la tabla por defecto del código.
model RacionSemanal {
  fincaId      String        @map("finca_id") @db.Uuid
  proposito    PropositoLote
  semana       Int
  gramosAveDia Int           @map("gramos_ave_dia")
  finca        Finca         @relation(fields: [fincaId], references: [id], onDelete: Cascade)

  @@id([fincaId, proposito, semana])
  @@map("raciones_semanales")
}

enum TipoAlimento {
  CONCENTRADO
  FORRAJE
  GRANO
  SUPLEMENTO
  SAL_MINERAL
  OTRO
}

enum Jornada {
  MANANA
  TARDE
  NOCHE
}

/// Cantidades en gramos enteros. El stock puede quedar negativo: no se rechaza un registro de campo.
/// Único por finca sin distinguir mayúsculas: índice `(finca_id, lower(nombre))` añadido a mano en la migración.
model Alimento {
  id                String            @id @default(uuid()) @db.Uuid
  fincaId           String            @map("finca_id") @db.Uuid
  nombre            String
  tipo              TipoAlimento
  stockGramos       Int               @default(0) @map("stock_gramos")
  stockMinimoGramos Int               @default(0) @map("stock_minimo_gramos")
  estado            EstadoRegistro    @default(ACTIVO)
  motivoBaja        String?           @map("motivo_baja")
  observaciones     String?
  creadoPorId       String            @map("creado_por_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  finca             Finca             @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  creadoPor         Usuario           @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  entradas          EntradaAlimento[]
  consumosVacunos   ConsumoVacuno[]
  consumosLotes     ConsumoLote[]

  @@index([fincaId])
  @@index([estado])
  @@map("alimentos")
}

model EntradaAlimento {
  id              String   @id @default(uuid()) @db.Uuid
  alimentoId      String   @map("alimento_id") @db.Uuid
  cantidadGramos  Int      @map("cantidad_gramos")
  fecha           DateTime @db.Date
  nota            String?
  registradoPorId String   @map("registrado_por_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  alimento        Alimento @relation(fields: [alimentoId], references: [id], onDelete: Restrict)
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([alimentoId, fecha])
  @@map("entradas_alimento")
}

model ConsumoVacuno {
  id              String   @id @default(uuid()) @db.Uuid
  vacunoId        String   @map("vacuno_id") @db.Uuid
  alimentoId      String   @map("alimento_id") @db.Uuid
  cantidadGramos  Int      @map("cantidad_gramos")
  jornada         Jornada
  fecha           DateTime @db.Date
  observaciones   String?
  clienteId       String?  @unique @map("cliente_id") @db.Uuid
  registradoPorId String   @map("registrado_por_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  vacuno          Vacuno   @relation(fields: [vacunoId], references: [id], onDelete: Restrict)
  alimento        Alimento @relation(fields: [alimentoId], references: [id], onDelete: Restrict)
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@unique([vacunoId, alimentoId, fecha, jornada])
  @@index([alimentoId, fecha])
  @@index([fecha])
  @@map("consumos_vacunos")
}

model ConsumoLote {
  id              String      @id @default(uuid()) @db.Uuid
  loteId          String      @map("lote_id") @db.Uuid
  alimentoId      String      @map("alimento_id") @db.Uuid
  /// Instantánea del espacio del lote al registrar el consumo.
  espacioId       String?     @map("espacio_id") @db.Uuid
  cantidadGramos  Int         @map("cantidad_gramos")
  jornada         Jornada
  fecha           DateTime    @db.Date
  observaciones   String?
  clienteId       String?     @unique @map("cliente_id") @db.Uuid
  registradoPorId String      @map("registrado_por_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  lote            LoteOviparo @relation(fields: [loteId], references: [id], onDelete: Restrict)
  espacio         Espacio?    @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  alimento        Alimento    @relation(fields: [alimentoId], references: [id], onDelete: Restrict)
  registradoPor   Usuario     @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@unique([loteId, alimentoId, fecha, jornada])
  @@index([alimentoId, fecha])
  @@index([fecha])
  @@index([espacioId, fecha])
  @@map("consumos_lotes")
}

enum TipoNovedad {
  ENFERMEDAD
  LESION
  MUERTE
  COMPORTAMIENTO
  PRODUCCION
  INFRAESTRUCTURA
  OTRO
}

enum PrioridadNovedad {
  BAJA
  MEDIA
  ALTA
}

enum EstadoNovedad {
  ABIERTA
  EN_SEGUIMIENTO
  CERRADA
}

enum EstadoCasoSalud {
  EN_OBSERVACION
  EN_TRATAMIENTO
  RECUPERADO
  FALLECIDO
}

/// Exactamente uno de `vacunoId` / `loteId` (CHECK añadido a mano en la migración).
model Novedad {
  id              String              @id @default(uuid()) @db.Uuid
  fincaId         String              @map("finca_id") @db.Uuid
  vacunoId        String?             @map("vacuno_id") @db.Uuid
  loteId          String?             @map("lote_id") @db.Uuid
  tipo            TipoNovedad
  prioridad       PrioridadNovedad    @default(MEDIA)
  descripcion     String
  fechaHora       DateTime            @default(now()) @map("fecha_hora") @db.Timestamptz(3)
  latitud         Decimal?            @db.Decimal(9, 6)
  longitud        Decimal?            @db.Decimal(9, 6)
  precisionMetros Int?                @map("precision_metros")
  fotoArchivo     String?             @map("foto_archivo")
  fotoMime        String?             @map("foto_mime")
  fotoBytes       Int?                @map("foto_bytes")
  estado          EstadoNovedad       @default(ABIERTA)
  cerradaEn       DateTime?           @map("cerrada_en") @db.Timestamptz(3)
  clienteId       String?             @unique @map("cliente_id") @db.Uuid
  registradoPorId String              @map("registrado_por_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  finca           Finca               @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  vacuno          Vacuno?             @relation(fields: [vacunoId], references: [id], onDelete: Restrict)
  lote            LoteOviparo?        @relation(fields: [loteId], references: [id], onDelete: Restrict)
  registradoPor   Usuario             @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  comentarios     ComentarioNovedad[]
  casosSalud      CasoSalud[]

  @@index([fincaId, fechaHora])
  @@index([vacunoId])
  @@index([loteId])
  @@map("novedades")
}

model ComentarioNovedad {
  id        String   @id @default(uuid()) @db.Uuid
  novedadId String   @map("novedad_id") @db.Uuid
  autorId   String   @map("autor_id") @db.Uuid
  texto     String
  createdAt DateTime @default(now()) @map("created_at")
  novedad   Novedad  @relation(fields: [novedadId], references: [id], onDelete: Cascade)
  autor     Usuario  @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([novedadId, createdAt])
  @@map("comentarios_novedad")
}

/// Exactamente uno de `vacunoId` / `loteId` (CHECK añadido a mano en la migración).
model CasoSalud {
  id                String          @id @default(uuid()) @db.Uuid
  fincaId           String          @map("finca_id") @db.Uuid
  vacunoId          String?         @map("vacuno_id") @db.Uuid
  loteId            String?         @map("lote_id") @db.Uuid
  novedadId         String?         @map("novedad_id") @db.Uuid
  diagnostico       String
  sintomas          String?
  estado            EstadoCasoSalud @default(EN_OBSERVACION)
  fechaInicio       DateTime        @map("fecha_inicio") @db.Date
  fechaFin          DateTime?       @map("fecha_fin") @db.Date
  animalesAfectados Int?            @map("animales_afectados")
  observaciones     String?
  registradoPorId   String          @map("registrado_por_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  finca             Finca           @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  vacuno            Vacuno?         @relation(fields: [vacunoId], references: [id], onDelete: Restrict)
  lote              LoteOviparo?    @relation(fields: [loteId], references: [id], onDelete: Restrict)
  novedad           Novedad?        @relation(fields: [novedadId], references: [id], onDelete: SetNull)
  registradoPor     Usuario         @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  tratamientos      Tratamiento[]

  @@index([fincaId, estado])
  @@index([vacunoId])
  @@index([loteId])
  @@map("casos_salud")
}

enum TipoMedicamento {
  ANTIBIOTICO
  ANTIPARASITARIO
  VACUNA
  VITAMINA
  ANTIINFLAMATORIO
  HORMONAL
  OTRO
}

enum UnidadMedicamento {
  ML
  G
  UNIDAD
  DOSIS
}

enum ViaAdministracion {
  ORAL
  INTRAMUSCULAR
  SUBCUTANEA
  INTRAVENOSA
  TOPICA
  EN_AGUA
  EN_ALIMENTO
  OTRA
}

/// El stock puede quedar negativo (no se rechaza un registro de campo).
/// Único por finca sin distinguir mayúsculas: índice `(finca_id, lower(nombre))` añadido a mano en la migración.
model Medicamento {
  id               String               @id @default(uuid()) @db.Uuid
  fincaId          String               @map("finca_id") @db.Uuid
  nombre           String
  tipo             TipoMedicamento
  unidad           UnidadMedicamento
  stock            Decimal              @default(0) @db.Decimal(12, 2)
  stockMinimo      Decimal              @default(0) @map("stock_minimo") @db.Decimal(12, 2)
  fechaVencimiento DateTime?            @map("fecha_vencimiento") @db.Date
  laboratorio      String?
  diasRetiroCarne  Int?                 @map("dias_retiro_carne")
  diasRetiroLeche  Int?                 @map("dias_retiro_leche")
  estado           EstadoRegistro       @default(ACTIVO)
  motivoBaja       String?              @map("motivo_baja")
  observaciones    String?
  creadoPorId      String               @map("creado_por_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  finca            Finca                @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  creadoPor        Usuario              @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  entradas         EntradaMedicamento[]
  tratamientos     Tratamiento[]

  @@index([fincaId])
  @@index([estado])
  @@map("medicamentos")
}

model EntradaMedicamento {
  id               String      @id @default(uuid()) @db.Uuid
  medicamentoId    String      @map("medicamento_id") @db.Uuid
  cantidad         Decimal     @db.Decimal(12, 2)
  fecha            DateTime    @db.Date
  fechaVencimiento DateTime?   @map("fecha_vencimiento") @db.Date
  nota             String?
  registradoPorId  String      @map("registrado_por_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  medicamento      Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Restrict)
  registradoPor    Usuario     @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([medicamentoId, fecha])
  @@map("entradas_medicamento")
}

/// Exactamente uno de `vacunoId` / `loteId` (CHECK añadido a mano en la migración).
model Tratamiento {
  id              String            @id @default(uuid()) @db.Uuid
  fincaId         String            @map("finca_id") @db.Uuid
  vacunoId        String?           @map("vacuno_id") @db.Uuid
  loteId          String?           @map("lote_id") @db.Uuid
  casoSaludId     String?           @map("caso_salud_id") @db.Uuid
  medicamentoId   String            @map("medicamento_id") @db.Uuid
  dosis           Decimal           @db.Decimal(12, 2)
  via             ViaAdministracion
  fecha           DateTime          @db.Date
  diasRetiroCarne Int?              @map("dias_retiro_carne")
  diasRetiroLeche Int?              @map("dias_retiro_leche")
  observaciones   String?
  registradoPorId String            @map("registrado_por_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  finca           Finca             @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  vacuno          Vacuno?           @relation(fields: [vacunoId], references: [id], onDelete: Restrict)
  lote            LoteOviparo?      @relation(fields: [loteId], references: [id], onDelete: Restrict)
  casoSalud       CasoSalud?        @relation(fields: [casoSaludId], references: [id], onDelete: SetNull)
  medicamento     Medicamento       @relation(fields: [medicamentoId], references: [id], onDelete: Restrict)
  registradoPor   Usuario           @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([fincaId, fecha])
  @@index([vacunoId])
  @@index([loteId])
  @@index([casoSaludId])
  @@index([medicamentoId, fecha])
  @@map("tratamientos")
}

/// Suscripciones de Web Push (una por navegador o dispositivo, identificada por su endpoint).
model SuscripcionPush {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("suscripciones_push")
}

/// Avisos push ya enviados, para no repetirlos. `clave` identifica el aviso (p. ej. `novedad-alta:<id>`).
model AvisoEnviado {
  id        String   @id @default(uuid()) @db.Uuid
  clave     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("avisos_enviados")
}

/// Bytes de las fotos de novedades. `archivo` coincide con `novedades.foto_archivo`.
/// Se guardan en la base porque el disco del despliegue no es persistente.
model Foto {
  archivo   String   @id
  datos     Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fotos")
}
